{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Switch to Desktop Platform",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/switch-platform.sh",
            "args": ["desktop"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Switch to Web Platform",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/switch-platform.sh",
            "args": ["web"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Switch to WeChat Platform",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/switch-platform.sh",
            "args": ["wechat"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Switch to Mobile Platform",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/switch-platform.sh",
            "args": ["mobile"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Build CLI",
            "type": "shell",
            "command": "go",
            "args": ["build", "./editor/cmd/onix"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Test Current Platform",
            "type": "shell",
            "command": "go",
            "args": ["test", "./..."],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Clean Build Cache",
            "type": "shell",
            "command": "go",
            "args": ["clean", "-cache"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
