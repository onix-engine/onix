{
    // Go 语言配置
    "go.useLanguageServer": true,
    "go.toolsManagement.autoUpdate": true,
    // 当前平台构建标签和环境变量 - 桌面平台 (Windows/macOS/Linux)
    "go.buildFlags": [],
    "go.testFlags": [],
    // 环境变量设置
    "go.toolsEnvVars": {
        "GOOS": "windows",
        "GOARCH": "amd64",
        "CGO_ENABLED": "1"
    },
    // 语言服务器设置
    "gopls": {
        "build.buildFlags": [],
        "build.env": {
            "GOOS": "linux",
            "GOARCH": "amd64",
            "CGO_ENABLED": "1"
        }
    },
    // 编辑器设置
    "editor.formatOnSave": true,
    "files.associations": {
        "*.go": "go"
    },
    // 终端设置
    "terminal.integrated.defaultProfile.windows": "UCRT64",
    "terminal.integrated.profiles.windows": {
        "UCRT64": {
            "path": "e:/msys64/usr/bin/zsh.exe",
            "args": [
                "--login",
                "-i"
            ],
            "env": {
                "MSYSTEM": "UCRT64",
                "CHERE_INVOKING": "1"
            },
            "icon": "terminal-bash"
        }
    }
}