    // Moving along an inverse column changes only its NDC component. Solve
    // that one-dimensional homogeneous quotient instead of inverting the
    // projection twice more for the disk endpoints. This also handles tilted
    // orthographic and off-axis perspective projections.
    let homogeneous=m*vec4<f32>(clip,1.0);
    let axes=vec2<f32>(length(m[0].xyz-position*m[0].w),length(m[1].xyz-position*m[1].w));
    let denominator=axes-radius*vec2<f32>(m[0].w,m[1].w);
    let extent=max(abs(vec2<f32>(radius*homogeneous.w)/denominator)*0.5,1.0/dims);
