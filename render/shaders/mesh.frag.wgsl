    let diskScale=inverseSqrt(f32(count));
    // Fixed disk offsets avoid per-sample trig and square roots.
    var blocked=0.0;
    for(var sampleIndex=0u;sampleIndex<32u;sampleIndex++) {
        if (sampleIndex>=count) { break; }
        let sampleUV=uv+SSAO_DISK[sampleIndex]*diskScale*extent;
        if (any(sampleUV<vec2<f32>(0.0)) || any(sampleUV>=vec2<f32>(1.0))) { continue; }
